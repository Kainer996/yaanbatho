# yaanbatho.com — local dev / production env vars.
# Copy to .env (or set as systemd EnvironmentFile in production) and fill in real values.

# Required for /api/generate-track (Pocket Producer music generation).
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Required for /api/identify-sound (Burbz bird auto-ID).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: token gating for /api/upload.
UPLOAD_TOKEN=
