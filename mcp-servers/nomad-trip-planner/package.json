{
  "name": "@yaanbatho/nomad-trip-planner",
  "version": "0.1.0",
  "description": "MCP server that plans short van-friendly day trips — destination, weather window, daylight, and parkup — so the driver never fiddles with Google Maps while moving.",
  "type": "module",
  "bin": {
    "nomad-trip-planner": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "fixtures",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "trip-planner",
    "van-life",
    "nomad",
    "weather",
    "parkup",
    "open-meteo",
    "agent",
    "openclaw",
    "claude"
  ],
  "author": "Yaan Batho",
  "license": "MIT"
}
