# Weather provider. "open-meteo" uses the free https://api.open-meteo.com/v1/forecast endpoint (no key required).
# Set to "fixture" to run fully offline against the bundled sample forecast.
NOMAD_WEATHER_PROVIDER=open-meteo

# Parkup provider. "fixture" reads fixtures/parkups.sample.json (ships in the package, works offline).
# Future values: "ioverlander" | "park4night" | "google-places" — implement and wire in src/parkups.ts.
NOMAD_PARKUP_PROVIDER=fixture

# Optional: path to a custom parkup fixture file. Defaults to the one bundled in /fixtures.
# NOMAD_PARKUP_FIXTURE=/absolute/path/to/parkups.json

# Optional driving speed assumption for drive-time estimates (km/h). Defaults to 60.
# NOMAD_ASSUMED_KMH=60

# Optional: default home/work anchor used when the caller omits a location. Lat,Lng.
# NOMAD_DEFAULT_ANCHOR=51.4545,-2.5879
