# Optional: path to a custom dj-knowledge.json. Defaults to the file shipped with the package.
# DJ_GENT_LIBRARY=/absolute/path/to/dj-knowledge.json

# Optional: default DJ persona used when the caller omits `persona`.
# Valid values are the ids under "personas" in dj-knowledge.json (e.g. "warehouse-techno", "peak-house", "sunrise").
# DJ_GENT_DEFAULT_PERSONA=warehouse-techno
