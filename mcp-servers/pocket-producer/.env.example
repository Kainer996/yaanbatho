# Base URL of the self-hosted gcui-art/suno-api proxy (https://github.com/gcui-art/suno-api).
# Run that proxy separately — it handles the Suno cookie so this server just speaks HTTP to it.
SUNO_API_BASE_URL=http://localhost:3000

# Optional: path to a custom reference-tracks.json. Defaults to the one shipped with the package.
# POCKET_PRODUCER_LIBRARY=/absolute/path/to/reference-tracks.json

# Optional: default producer style applied when the caller does not pick one.
# Valid values are the ids under "producers" in reference-tracks.json (e.g. "kainer", "il-diablo").
# POCKET_PRODUCER_DEFAULT_STYLE=kainer
