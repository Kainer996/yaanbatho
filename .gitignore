# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# music files (optional - uncomment if you don't want to commit music)
# public/music/*.mp3
# public/music/*.wma


# videos/*.mp4

# python virtualenvs
burbz/venv/
**/venv/
**/__pycache__/
*.pyc

# runtime logs / pids
*.log
*.pid

# gallery uploads (runtime user content) — keep baseline placeholders, ignore timestamp-prefixed uploads
images/gallery/[0-9]*

# gallery upload metadata (written at runtime)
data/gallery-items.json

# secrets (defensive — none currently present, but guard future drops)
*.key
id_rsa*
credentials.*
keys.json

# Ava server snapshot safety exclusions
.env
.env.*
node_modules/
.next/
venv/
.venv/
__pycache__/
.cache/
dist/
build/
coverage/
*.log
*.bak
*.backup
*.old
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.db
